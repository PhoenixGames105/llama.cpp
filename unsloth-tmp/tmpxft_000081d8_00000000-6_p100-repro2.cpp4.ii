        for (int i = i0; i < i0 + (32 / (4 * 1)) /2; ++i) {
            
            sumi = ggml_cuda_dp4a(v[i], u[i], sumi);
        }

        sumf += d8_0[i0/((32 / (4 * 1)) /2)]*sumi;
    }

