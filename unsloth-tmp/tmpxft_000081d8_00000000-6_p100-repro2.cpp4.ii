__declspec(__device__) __forceinline uint8_t ggml_cuda_float_to_fp4_e2m1(float x, float e) {
    const uint8_t sign_bit = (x < 0.0f) << 3;
    float         ax       = fabsf(x) * e;

    
    static constexpr float pos_lut[8] = { 0.0f, 0.5f, 1.0f, 1.5f, 2.0f, 3.0f, 4.0f, 6.0f };

    int   best_i   = 0;
    float best_err = fabsf(ax - pos_lut[0]);

#pragma unroll
    for (int i = 1; i < 8; ++i) {
        const float err = fabsf(ax - pos_lut[i]);
        if (err < best_err) {
            best_err = err;
            best_i   = i;
        }
    }

    return static_cast<uint8_t>(best_i | sign_bit);
}







static const uint3 init_fastdiv_values(uint64_t d_64) {
    if (!(d_64 != 0)) ggml_abort("E:\\P100-LLama.cpp\\llama.cpp\\ggml\\src\\ggml-cuda\\common.cuh", 937, "GGML_ASSERT(%s) failed", "d_64 != 0") ;
