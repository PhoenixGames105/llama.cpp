    if (!(Q->nb[0] == ggml_element_size(Q))) ggml_abort("E:\\P100-LLama.cpp\\llama.cpp\\ggml\\src\\ggml-cuda\\fattn-common.cuh", 1002, "GGML_ASSERT(%s) failed", "Q->nb[0] == ggml_element_size(Q)") ;
    if (!(K->nb[0] == ggml_element_size(K))) ggml_abort("E:\\P100-LLama.cpp\\llama.cpp\\ggml\\src\\ggml-cuda\\fattn-common.cuh", 1003, "GGML_ASSERT(%s) failed", "K->nb[0] == ggml_element_size(K)") ;
    if (!(V->nb[0] == ggml_element_size(V))) ggml_abort("E:\\P100-LLama.cpp\\llama.cpp\\ggml\\src\\ggml-cuda\\fattn-common.cuh", 1004, "GGML_ASSERT(%s) failed", "V->nb[0] == ggml_element_size(V)") ;

    if (!(!mask || mask->type == GGML_TYPE_F16)) ggml_abort("E:\\P100-LLama.cpp\\llama.cpp\\ggml\\src\\ggml-cuda\\fattn-common.cuh", 1006, "GGML_ASSERT(%s) failed", "!mask || mask->type == GGML_TYPE_F16") ;

