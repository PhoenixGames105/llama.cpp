    __declspec(__shared__) float m_s[R];                              
    __declspec(__shared__) float a_s[R];                              
    __declspec(__shared__) float red_s[8][R];
    constexpr int LRP  = R <= 16 ? 16 : 32;   
    constexpr int LPPS = C / (NT/LRP);        
    static_assert(C % (NT/LRP) == 0, "bad denominator split");
    __declspec(__shared__) float lsum_s[NT/32 ][LRP];

    ggml_cuda_pdl_sync();

    
    
    const float qscale = scale*LOG2E;
    for (int idx = tid; idx < RG*RQP*D; idx += NT) {
        const int rgi = idx / (RQP*D), rem = idx % (RQP*D);
        const int rl  = rem / D, dim = rem % D;
        const int r   = rgi*RQ + rl;
        const int t = r / ncols2, g = r % ncols2;
        float q = 0.0f;
